# Copy to .env and fill secrets locally. Django settings load it automatically.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=website
POSTGRES_USER=website
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Local filesystem storage; configure persistent volume in later infrastructure tickets.
DJANGO_MEDIA_URL=/media/
DJANGO_UPLOAD_MAX_BYTES=10485760
# DJANGO_MEDIA_ROOT=/absolute/path/to/media
