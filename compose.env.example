# Copy to backend/.env (ignored by backend/.gitignore). Generate both secrets.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

POSTGRES_DB=website
POSTGRES_USER=website
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
PROXY_PORT=3000
PUBLIC_SITE_ORIGIN=http://localhost:3000
# Django limits each file to 10 MiB; the proxy allows multipart form overhead.
DJANGO_UPLOAD_MAX_BYTES=10485760
UPLOAD_REQUEST_MAX_SIZE=11MiB
