# Copy to /etc/personal-website/offsite-backup.env and protect it (root:website-backup, mode 0640).
BACKUP_PROJECT_NAME=personal-website-production
BACKUP_COMPOSE_FILE=/opt/personal-website/compose.production.yaml
BACKUP_ENV_FILE=/etc/personal-website/website-production.env
BACKUP_STAGING_ROOT=/var/lib/personal-website-backup
BACKUP_RETENTION_DAYS=90

# Restic encrypts snapshot contents before sending them over SSH.
RESTIC_REPOSITORY=sftp:website-backup:/srv/restic/personal-website
RESTIC_PASSWORD_FILE=/etc/personal-website/restic-password
RESTIC_CACHE_DIR=/var/cache/personal-website-backup/restic
