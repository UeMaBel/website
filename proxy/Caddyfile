{
	auto_https off
}

http://localhost {
	@static path /static/*
	handle @static {
		uri strip_prefix /static
		root * /srv/static
		file_server
	}

	@media path /media/*
	handle @media {
		uri strip_prefix /media
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'; sandbox"
		@pdf path_regexp pdf (?i)\.pdf$
		header @pdf Content-Disposition attachment
		root * /srv/media
		file_server
	}

	@media_upload path /admin/uploads/uploadedmedia/add/ /admin/uploads/uploadedmedia/*/change/
	request_body @media_upload {
		max_size {$UPLOAD_REQUEST_MAX_SIZE:11MiB}
	}

	@django path /api/* /admin /admin/*
	handle @django {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

http://demo.localhost {
	handle {
		reverse_proxy demo:80
	}
}

http://{$ANALYTICS_HOST:analytics.localhost} {
	handle {
		reverse_proxy umami:3000
	}
}
