{
	auto_https off
}

http://localhost {
	@django path /api/* /admin /admin/* /static/* /media/*
	handle @django {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

http://demo.localhost {
	handle {
		reverse_proxy demo:80
	}
}

http://{$ANALYTICS_HOST:analytics.localhost} {
	handle {
		reverse_proxy umami:3000
	}
}
